<Window x:Class="MouseClicker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="650" MinWidth="520" MinHeight="420"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#18263E"
        Background="#F2F5FA" WindowStartupLocation="CenterScreen" ThemeMode="Light">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D9E1ED"/>
            <Setter Property="Foreground" Value="#263954"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#2563B9"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,4"/><Setter Property="BorderBrush" Value="#D9E1ED"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,4"/><Setter Property="BorderBrush" Value="#D9E1ED"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,4,12,4"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E0E6F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Padding" Value="7,4"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" CornerRadius="8" Background="#F7F9FC" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#EEF3FB"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EAF1FF"/><Setter TargetName="Row" Property="BorderBrush" Value="#8CAFE5"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#2563B9"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="8,3" Background="White" BorderBrush="#E0E6F0" BorderThickness="0,0,0,1">
            <MenuItem x:Name="FileMenu"><MenuItem x:Name="SaveMenu" Click="Save_Click"/><MenuItem x:Name="LoadMenu" Click="Load_Click"/></MenuItem>
            <MenuItem x:Name="SettingsMenu"><MenuItem x:Name="HotkeyMenu" Click="Hotkey_Click"/></MenuItem>
            <MenuItem x:Name="LanguageMenu"/>
            <MenuItem x:Name="HelpMenu"><MenuItem x:Name="GuideMenu" Click="Help_Click"/></MenuItem>
            <MenuItem x:Name="AboutMenu" Click="About_Click"/>
        </Menu>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E6F0" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel>
                <Button x:Name="StartButton" Click="Start_Click" Background="#2563B9" Foreground="White" FontSize="14" FontWeight="SemiBold" Padding="12,7" Margin="0"/>
                <WrapPanel HorizontalAlignment="Center" Margin="0,7,0,0"><TextBlock x:Name="RunHint" FontSize="12" Foreground="#526075" VerticalAlignment="Center"/>
                <Button x:Name="UpdateButton" Click="About_Click" Visibility="Collapsed" Margin="12,0,0,0" Padding="8,2" FontSize="12" Foreground="#2058A4" BorderThickness="0"/></WrapPanel>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,10,12,10">
                <Grid x:Name="WorkspaceGrid">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="AreasColumn"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="AreasCard" Style="{StaticResource Card}" Margin="0,0,0,6" VerticalAlignment="Top"><StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AreasTitle" Style="{StaticResource SectionTitle}"/><Border Grid.Column="1" Background="#EDF2FA" CornerRadius="10" Padding="9,2" VerticalAlignment="Top"><TextBlock x:Name="AreaCount" FontSize="12" Foreground="#526075"/></Border></Grid>
                        <TextBlock x:Name="AreasHint" Margin="0,0,0,6" FontSize="12" Foreground="#526075"/>
                        <ListBox x:Name="AreasList" Height="100" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Selection_Changed" MouseDoubleClick="Condition_Click" MouseMove="Areas_MouseMove" MouseLeave="Areas_MouseLeave" PreviewMouseRightButtonDown="Areas_RightClick" PreviewMouseLeftButtonDown="Areas_LeftClick" ScrollViewer.ScrollChanged="Areas_ScrollChanged">
                            <ListBox.ItemTemplate><DataTemplate><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock FontSize="11" Foreground="#526075" Margin="0,2,0,0"><Run Text="X "/><Run Text="{Binding Area.X, Mode=OneWay}"/><Run Text="   Y "/><Run Text="{Binding Area.Y, Mode=OneWay}"/><Run Text="   &#x00B7;   "/><Run Text="{Binding Area.Width, Mode=OneWay}"/><Run Text=" &#x00D7; "/><Run Text="{Binding Area.Height, Mode=OneWay}"/></TextBlock></StackPanel>
                                <Border Grid.Column="1" Background="White" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><TextBlock x:Name="MouseBadge" ToolTip="{DynamicResource LeftButtonDescription}" Text="L" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock ToolTip="{DynamicResource ConditionDescription}" Text="IF" FontSize="10" Foreground="#2058A4" Margin="5,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Condition}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                            </Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding RightButton}" Value="True"><Setter TargetName="MouseBadge" Property="Text" Value="R"/><Setter TargetName="MouseBadge" Property="ToolTip" Value="{DynamicResource RightButtonDescription}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
                            <ListBox.ContextMenu><ContextMenu><MenuItem x:Name="LeftMenu" Click="Left_Click"/><MenuItem x:Name="RightMenu" Click="Right_Click"/><Separator/><MenuItem x:Name="ConditionMenu" Click="Condition_Click"/></ContextMenu></ListBox.ContextMenu>
                        </ListBox>
                        <WrapPanel Margin="0,6,0,0"><Button x:Name="AddButton" Click="Add_Click" Background="#EAF1FF" BorderBrush="#BCD0EF" Foreground="#2058A4"/><Button x:Name="RemoveButton" Click="Remove_Click"/><Button x:Name="UpButton" Click="Up_Click"/><Button x:Name="DownButton" Click="Down_Click"/><Button x:Name="ConditionButton" Click="Condition_Click"/></WrapPanel>
                    </StackPanel></Border>
                    <StackPanel x:Name="SettingsCards" Grid.Row="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6"><StackPanel x:Name="TimingPanel">
                            <TextBlock x:Name="TimingTitle" Style="{StaticResource SectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Name="IntervalLabel" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <TextBox x:Name="IntervalInput" Grid.Column="1" Text="1000" TextChanged="Timing_Changed" Margin="0,0,0,6"/>
                                <TextBlock x:Name="JitterLabel" Grid.Column="3" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <TextBox x:Name="JitterInput" Grid.Column="4" Text="100" TextChanged="Timing_Changed" Margin="0,0,0,6"/>
                                <TextBlock x:Name="SequenceLabel" Grid.Row="1" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="SequenceInput" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"/>
                            </Grid>
                            <TextBlock x:Name="TimingHint" FontSize="12" Foreground="#96500B" Margin="0,4,0,0"/>
                            <CheckBox x:Name="HardwareInput" FontSize="12"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="DisplayTitle" Style="{StaticResource SectionTitle}"/><WrapPanel><CheckBox x:Name="OverlayInput" IsChecked="True" Click="Overlay_Click" FontSize="12"/><CheckBox x:Name="DetectionInput" Click="Overlay_Click" FontSize="12"/><CheckBox x:Name="HighlightInput" IsChecked="True" Click="Overlay_Click" FontSize="12"/></WrapPanel></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>



